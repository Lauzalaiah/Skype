{
  "name": "skip-desktop",
  "private": true,
  "version": "8.140.0",
  "description": "Skip — application de bureau. Recréation indépendante, faite par un fan, sans lien avec Microsoft.",
  "homepage": "https://lauzalaiah.github.io/Skype/",
  "license": "MIT",
  "author": "Skip",
  "main": "main.js",
  "desktopName": "skip-desktop.desktop",
  "type": "module",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win --publish never",
    "build:linux": "electron-builder --linux --publish never",
    "build:mac": "electron-builder --mac --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "app.skip.fan",
    "productName": "Skip",
    "copyright": "Skip — recréation indépendante par un fan, sans lien avec Microsoft.",
    "publish": [
      {
        "provider": "github",
        "owner": "Lauzalaiah",
        "repo": "Skip"
      }
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "maj.js",
      "mise-a-jour-possible.js",
      "serveur-partage.js",
      "preload.cjs",
      "package.json",
      "node_modules/**/*",
      "build/icon.png",
      "build/icons/**/*"
    ],
    "extraResources": [
      {
        "from": "../server",
        "to": "server"
      },
      {
        "from": "../public",
        "to": "public"
      },
      {
        "from": "../package.json",
        "to": "server/package.json"
      },
      {
        "from": "build/module-type.json",
        "to": "public/package.json"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "Skip-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Skip",
      "artifactName": "Skip-Setup-${version}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "icon": "build/icons",
      "category": "Network;InstantMessaging;VideoConference",
      "maintainer": "Skip <skip@users.noreply.github.com>",
      "synopsis": "Recréation indépendante de l'ancien Skype",
      "description": "Messagerie et appels audio/vidéo. Recréation indépendante faite par un fan, sans lien avec Microsoft.",
      "desktop": {
        "entry": {
          "Name": "Skip",
          "GenericName": "Messagerie et appels",
          "Keywords": "chat;messagerie;appel;visio;video;skip;",
          "StartupWMClass": "Skip"
        }
      },
      "artifactName": "Skip-${version}.${ext}",
      "syncDesktopName": true
    },
    "deb": {
      "priority": "optional"
    },
    "rpm": {
      "fpm": [
        "--rpm-rpmbuild-define=_build_id_links none"
      ]
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.social-networking",
      "artifactName": "Skip-${version}.${ext}",
      "extendInfo": {
        "NSCameraUsageDescription": "Skip a besoin de la caméra pour les appels vidéo.",
        "NSMicrophoneUsageDescription": "Skip a besoin du micro pour les appels et les messages vocaux."
      }
    }
  }
}
