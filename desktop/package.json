{
  "name": "skype-reborn-desktop",
  "private": true,
  "version": "8.136.0",
  "description": "Skype Reborn — application de bureau. Recréation indépendante, faite par un fan, sans lien avec Microsoft.",
  "author": "Skype Reborn",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win nsis --publish never",
    "build:linux": "electron-builder --linux AppImage --publish never",
    "build:mac": "electron-builder --mac dmg --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^31.3.1",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "app.skypereborn.fan",
    "productName": "Skype",
    "copyright": "Skype Reborn — recréation indépendante par un fan, sans lien avec Microsoft.",
    "publish": [
      {
        "provider": "github",
        "owner": "Lauzalaiah",
        "repo": "Skype"
      }
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "maj.js",
      "serveur-partage.js",
      "preload.cjs",
      "package.json",
      "node_modules/**/*",
      "build/icon.png"
    ],
    "extraResources": [
      {
        "from": "../server",
        "to": "server"
      },
      {
        "from": "../public",
        "to": "public"
      },
      {
        "from": "../package.json",
        "to": "server/package.json"
      },
      {
        "from": "build/module-type.json",
        "to": "public/package.json"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "Skype-Reborn-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Skype",
      "artifactName": "Skype-Reborn-Setup-${version}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icon.png",
      "category": "Network",
      "artifactName": "Skype-Reborn-${version}.${ext}"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.social-networking",
      "artifactName": "Skype-Reborn-${version}.${ext}"
    }
  }
}